{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stylens-lite-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-11",
	"observability": {
		"enabled": true
		// head_sampling_rate defaults to 1 (100% of requests). Lower per-env in production if log volume grows.
	},
	// Shared non-secret vars (dev defaults)
	// FREE_TIER_*: trial window then monthly session quota (-1 = unlimited). See docs/subscription-limits.md
	"vars": {
		"ENV_NAME": "dev",
		"FREE_TIER_TRIAL_DAYS": "7",
		"FREE_TIER_TRIAL_SESSION_LIMIT": "-1",
		"FREE_TIER_MONTHLY_SESSION_LIMIT": "5",
		"FREE_TIER_MESSAGE_PER_SESSION_LIMIT": "20",
		"FREE_TIER_IMAGE_PER_SESSION_LIMIT": "10",
		"POSTHOG_HOST": "https://us.i.posthog.com"
	},
	// Dev bindings (default) - this makes tools like d1studio work seamlessly locally
	"d1_databases": [
		{
			"binding": "GOSTYLENS_DB",
			"database_name": "__DB_NAME__",
			"database_id": "__DB_ID__"
		}
	],
	"r2_buckets": [
		{
			"binding": "OUTFIT_PHOTOS_BUCKET",
			"bucket_name": "__R2_BUCKET__",
			"remote": true
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		// ── Staging environment ──────────────────────────────
		"staging": {
			"name": "stylens-lite-api-staging",
			"vars": {
				"ENV_NAME": "staging",
				"FREE_TIER_TRIAL_DAYS": "7",
				"FREE_TIER_TRIAL_SESSION_LIMIT": "-1",
				"FREE_TIER_MONTHLY_SESSION_LIMIT": "5",
				"FREE_TIER_MESSAGE_PER_SESSION_LIMIT": "20",
				"FREE_TIER_IMAGE_PER_SESSION_LIMIT": "10",
				"POSTHOG_HOST": "https://us.i.posthog.com"
			},
			"d1_databases": [
				{
					"binding": "GOSTYLENS_DB",
					"database_name": "__DB_NAME__",
					"database_id": "__DB_ID__"
				}
			],
			"r2_buckets": [
				{
					"binding": "OUTFIT_PHOTOS_BUCKET",
					"bucket_name": "__R2_BUCKET__",
					"remote": true
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		},
		// ── Production environment ──────────────────────────────
		"production": {
			"name": "stylens-lite-api-prod",
			"vars": {
				"ENV_NAME": "production",
				"FREE_TIER_TRIAL_DAYS": "7",
				"FREE_TIER_TRIAL_SESSION_LIMIT": "-1",
				"FREE_TIER_MONTHLY_SESSION_LIMIT": "5",
				"FREE_TIER_MESSAGE_PER_SESSION_LIMIT": "20",
				"FREE_TIER_IMAGE_PER_SESSION_LIMIT": "10",
				"POSTHOG_HOST": "https://us.i.posthog.com"
			},
			"d1_databases": [
				{
					"binding": "GOSTYLENS_DB",
					"database_name": "__DB_NAME__",
					"database_id": "__DB_ID__"
				}
			],
			"r2_buckets": [
				{
					"binding": "OUTFIT_PHOTOS_BUCKET",
					"bucket_name": "__R2_BUCKET__",
					"remote": true
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}