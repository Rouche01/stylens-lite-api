{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stylens-lite-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-11",
	"observability": {
		"enabled": true
	},
	// Shared non-secret vars (dev defaults)
	"vars": {
		"ENV_NAME": "dev",
		"FREE_TIER_SESSION_LIMIT": "3"
	},
	// Dev bindings (default) - this makes tools like d1studio work seamlessly locally
	"d1_databases": [
		{
			"binding": "GOSTYLENS_DB",
			"database_name": "__DB_NAME__",
			"database_id": "__DB_ID__"
		}
	],
	"r2_buckets": [
		{
			"binding": "OUTFIT_PHOTOS_BUCKET",
			"bucket_name": "__R2_BUCKET__",
			"remote": true
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		// ── Staging environment ──────────────────────────────
		"staging": {
			"name": "stylens-lite-api-staging",
			"vars": {
				"ENV_NAME": "staging",
				"FREE_TIER_SESSION_LIMIT": "3"
			},
			"d1_databases": [
				{
					"binding": "GOSTYLENS_DB",
					"database_name": "__DB_NAME__",
					"database_id": "__DB_ID__"
				}
			],
			"r2_buckets": [
				{
					"binding": "OUTFIT_PHOTOS_BUCKET",
					"bucket_name": "__R2_BUCKET__",
					"remote": true
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		},
		// ── Production environment ──────────────────────────────
		"production": {
			"name": "stylens-lite-api-prod",
			"vars": {
				"ENV_NAME": "production",
				"FREE_TIER_SESSION_LIMIT": "3"
			},
			"d1_databases": [
				{
					"binding": "GOSTYLENS_DB",
					"database_name": "__DB_NAME__",
					"database_id": "__DB_ID__"
				}
			],
			"r2_buckets": [
				{
					"binding": "OUTFIT_PHOTOS_BUCKET",
					"bucket_name": "__R2_BUCKET__",
					"remote": true
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}